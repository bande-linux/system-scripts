#!/bin/sh

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs) prereqs; exit 0 ;;
esac

[ -d /vendorfw ] || exit 0

. /scripts/functions

mkdir -p "${rootmnt}/lib/firmware/vendor"
if ! mount -t tmpfs -o mode=0755 vendorfw "${rootmnt}/lib/firmware/vendor"; then
    log_failure_msg "Unbound: cannot mount ${rootmnt}/lib/firmware/vendor"
    exit 0
fi
cp -a /vendorfw/. "${rootmnt}/lib/firmware/vendor/"
